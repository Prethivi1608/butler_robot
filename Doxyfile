# Doxyfile Configuration for ROS 2 Workspace

PROJECT_NAME           = "Butler Robot"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Documentation for the Butler Robot ROS 2 workspace"
OUTPUT_DIRECTORY       = "docs"

INPUT                  = "src"
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.hpp *.py *.md

# Enable extraction of all documentation
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Source Code Listings
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO

# HTML Output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES

# LaTeX (for PDF)
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex

# Python Support
EXTENSION_MAPPING      = py=C++
ENABLE_PREPROCESSING   = YES

# Dot Graphs (for class and dependency diagrams)
HAVE_DOT              = YES
DOT_GRAPH_MAX_NODES   = 100
CALL_GRAPH            = YES
CALLER_GRAPH          = YES
CLASS_DIAGRAMS        = YES

